<UserControl x:Class="McDownload.View.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="clr-namespace:McDownload.i18n">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="{i18n:Loc AboutView, Heading}" Style="{StaticResource Heading}"/>
        <Border Style="{StaticResource Card}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#E2EFFF" CornerRadius="9" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="{i18n:Loc AboutView, ProductAbbreviation}" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Text="{i18n:Loc AboutView, ProductName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#F0F6FD" CornerRadius="4" Padding="10,7" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="ProductVersionLabel" Text="{Binding ProductVersion, StringFormat={i18n:Loc AboutView, VersionFormat}}" Foreground="{StaticResource Accent}"/></Border>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{i18n:Loc AboutView, CopyrightHeading}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{i18n:Loc AboutView, HmclCopyright}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock Text="{i18n:Loc AboutView, ProjectCopyright}" Foreground="#65758A" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="{i18n:Loc AboutView, LicensesHeading}" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="{i18n:Loc AboutView, GameDistributionNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock Text="{i18n:Loc AboutView, ThirdPartyLicenseNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="OpenLicensesButton" Content="{i18n:Loc AboutView, OpenLicenses}" Command="{Binding NavigateCommand}" CommandParameter="Licenses" Style="{StaticResource Primary}"/>
                <Button x:Name="OpenProjectLicenseButton" Content="{i18n:Loc AboutView, OpenProjectLicense}" Command="{Binding NavigateCommand}" CommandParameter="ProjectLicense"/>
            </WrapPanel>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
