<UserControl x:Class="McDownload.View.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="关于" Style="{StaticResource Heading}"/>
        <Border Style="{StaticResource Card}"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#E2EFFF" CornerRadius="9" Width="48" Height="48" Margin="0,0,14,0"><TextBlock Text="SCI" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Grid.Column="1" Text="SolidCraft Installer" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Border Grid.Column="2" Background="#F0F6FD" CornerRadius="4" Padding="10,7" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="ProductVersionLabel" Text="{Binding ProductVersion, StringFormat=版本 {0}}" Foreground="{StaticResource Accent}"/></Border>
        </Grid></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="版权" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Copyright (C) 2020–2026 huangyuhui and HMCL contributors." Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock Text="Copyright © 2026 NekomiyaRinko." Foreground="#65758A" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="许可证与声明" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="SCI 不托管、不分发游戏文件。Minecraft 文件及加载器由 SCI 从 Mojang、加载器官方源或第三方镜像源获取后写入用户本地实例目录，不随 SCI 发布包捆绑，各自由其权利方的使用条款管理。" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock Text="SCI 的 GPL 声明不改变第三方组件各自的许可，由各自权利方的使用条款管理。" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="OpenLicensesButton" Content="开放源代码许可" Command="{Binding NavigateCommand}" CommandParameter="Licenses" Style="{StaticResource Primary}"/>
                <Button x:Name="OpenProjectLicenseButton" Content="开源协议" Command="{Binding NavigateCommand}" CommandParameter="ProjectLicense"/>
            </WrapPanel>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
