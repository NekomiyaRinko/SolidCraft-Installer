<UserControl x:Class="McDownload.View.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i18n="clr-namespace:McDownload.i18n">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{i18n:Loc SettingsView, Heading}" Style="{StaticResource Heading}"/><StackPanel Style="{StaticResource IdlePanel}"><Border Style="{StaticResource Card}"><StackPanel>
        <TextBlock Text="{i18n:Loc SettingsView, Java}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{i18n:Loc SettingsView, JavaPath}" Style="{StaticResource Label}"/><DockPanel><Button x:Name="JavaBrowseButton" Content="{i18n:Loc SettingsView, Browse}" DockPanel.Dock="Right" Command="{Binding BrowseJavaCommand}" Style="{StaticResource RowButton}"/><TextBox x:Name="JavaPathInput" Text="{Binding JavaPath, UpdateSourceTrigger=LostFocus}"/></DockPanel><TextBlock Text="{i18n:Loc SettingsView, JavaDiscoveryHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        <TextBlock Text="{i18n:Loc SettingsView, DefaultMemory}" Style="{StaticResource Label}"/><TextBox x:Name="MemoryInput" Text="{Binding DefaultMemoryMb, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/><TextBlock Text="{i18n:Loc SettingsView, MemoryPreferenceHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc SettingsView, DownloadSource}" FontSize="17" FontWeight="SemiBold"/>
        <ComboBox x:Name="DownloadSourceCombo" ItemsSource="{Binding DownloadSources}" SelectedItem="{Binding SelectedDownloadSource}" Margin="0,12,0,0"/>
        <TextBlock Text="{i18n:Loc SettingsView, MirrorNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        <TextBlock Text="{i18n:Loc SettingsView, MaxDownloadThreads}" Style="{StaticResource Label}"/>
        <TextBox x:Name="MaxDownloadThreadsInput" Text="{Binding MaxDownloadThreads, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
        <TextBlock Text="{i18n:Loc SettingsView, DownloadThreadsHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" IsEnabled="{Binding CanEditCurseForgeKey}"><StackPanel>
        <TextBlock Text="{i18n:Loc SettingsView, CurseForge}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="{i18n:Loc SettingsView, ApplicationApiKey}" Style="{StaticResource Label}"/>
        <PasswordBox x:Name="CurseForgeKeyInput" MinHeight="36" Padding="10,7" BorderBrush="#CFDAE8" BorderThickness="1" Background="White" Foreground="#28394C"/>
        <TextBlock Text="{i18n:Loc SettingsView, ApiKeyInstructions}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        <Button x:Name="CurseForgeConsoleButton" Content="{i18n:Loc SettingsView, OpenCurseForgeConsole}" Click="OpenCurseForgeConsole" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        <CheckBox Content="{i18n:Loc SettingsView, RememberApiKey}" IsChecked="{Binding RememberCurseForgeKey}" Margin="0,12,0,14"/>
        <WrapPanel><Button x:Name="ApplyCurseForgeKeyButton" Content="{i18n:Loc SettingsView, Apply}" Style="{StaticResource Primary}" Click="ApplyCurseForgeKey"/>
            <Button Content="{i18n:Loc SettingsView, Clear}" Click="ClearCurseForgeKey"/></WrapPanel>
        <TextBlock Text="{i18n:Loc SettingsView, ApiKeyStorageNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding CurseForgeMessage}" Foreground="#65758A" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc SettingsView, GameDirectory}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{i18n:Loc SettingsView, MinecraftRoot}" Style="{StaticResource Label}"/><DockPanel><Button x:Name="RootBrowseButton" Content="{i18n:Loc SettingsView, Browse}" DockPanel.Dock="Right" Command="{Binding BrowseRootCommand}" Style="{StaticResource RowButton}"/><TextBox x:Name="MinecraftRootInput" Text="{Binding MinecraftRoot, UpdateSourceTrigger=LostFocus}"/></DockPanel>
        <Button Content="{i18n:Loc SettingsView, UseDefaultRoot}" Command="{Binding UseDefaultRootCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <TextBlock Text="{i18n:Loc SettingsView, SharedAssetsDirectory}" Style="{StaticResource Label}"/><TextBox Text="{Binding AssetsPath, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{i18n:Loc SettingsView, SharedLibrariesDirectory}" Style="{StaticResource Label}"/><TextBox Text="{Binding LibrariesPath, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{i18n:Loc SettingsView, DirectoryIsolationNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#65758A" Margin="0,0,0,16"/>
    </StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc SettingsView, DiagnosticLogs}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="{i18n:Loc SettingsView, CurrentLogFile}" Style="{StaticResource Label}"/><TextBox Text="{Binding DiagnosticLogPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
        <TextBlock Text="{i18n:Loc SettingsView, DiagnosticPrivacyNotice}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,14,0,0">
            <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsManagingLogs}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
            <Button Content="{i18n:Loc SettingsView, OpenLogFolder}" Command="{Binding OpenLogsCommand}"/>
            <Button x:Name="LogExportButton" Content="{i18n:Loc SettingsView, ExportLogs}" Command="{Binding ExportLogsCommand}"/>
            <Button x:Name="LogDeleteButton" Content="{i18n:Loc SettingsView, DeleteLogs}" Command="{Binding RequestDeleteLogsCommand}" Style="{StaticResource Danger}"/>
        </WrapPanel>
        <TextBlock Text="{Binding LogMessage}" TextWrapping="Wrap" Foreground="#65758A" Margin="0,8,0,0"/>
    </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
