<UserControl x:Class="McDownload.View.InstanceListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"/><TextBlock Text="我的实例" Style="{StaticResource Heading}"/></DockPanel>
        <Grid x:Name="InstanceColumns" Grid.Row="1"><Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="16"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInstance}" Value="{x:Null}"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
            <ColumnDefinition x:Name="InstanceDetailColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="300"/><Style.Triggers><DataTrigger Binding="{Binding SelectedInstance}" Value="{x:Null}"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
        </Grid.ColumnDefinitions>
            <Grid><ListBox x:Name="InstanceList" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource InstanceListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}" Margin="0,6,0,2"/><TextBlock Text="{Binding Loader}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Isolation}" FontSize="11" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <StackPanel x:Name="EmptyInstances" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Instances.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="还没有实例" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="安装 Minecraft，创建第一个实例。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#65758A" Margin="0,12,0,20"/>
                    <Button Content="下载游戏" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Download" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="InstanceDetails" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding SelectedInstance}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="实例详情" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedInstance.Name}" Margin="0,14,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedInstance.Loader}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedInstance.Details}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedInstance.Version.DirectoryPath}" TextWrapping="Wrap" Foreground="#65758A" Margin="0,8"/>
                <Button Content="管理加载器" Command="{Binding ManageLoaderCommand}" Visibility="{Binding SelectedInstance.CanManage, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,8"/>
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}"/>
                <Button Content="删除实例" Command="{Binding DeleteCommand}" Visibility="{Binding SelectedInstance.CanManage, Converter={StaticResource BoolVisibility}}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Danger}"><Style.Triggers><DataTrigger Binding="{Binding State.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
