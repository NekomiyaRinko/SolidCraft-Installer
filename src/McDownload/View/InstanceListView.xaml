<UserControl x:Class="McDownload.View.InstanceListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"/><TextBlock Text="我的实例" Style="{StaticResource Heading}"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Grid><ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding MinecraftVersion, StringFormat=Minecraft {0}}" Margin="0,8,0,4"/><TextBlock Text="{Binding Loader}"/><TextBlock Text="{Binding Isolation}" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock Text="还没有实例，请前往“下载游戏”安装 Minecraft。" TextWrapping="Wrap" Margin="20"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Instances.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource IdlePanel}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="实例详情" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedInstance.Name}" Margin="0,14,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedInstance.Loader}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedInstance.Details}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SelectedInstance.Version.DirectoryPath}" TextWrapping="Wrap" Foreground="#65758A" Margin="0,8"/>
                <Button Content="管理加载器" Command="{Binding ManageLoaderCommand}" Visibility="{Binding SelectedInstance.CanManage, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,8"/>
                <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}"/>
                <Button Content="删除实例" Command="{Binding DeleteCommand}" Visibility="{Binding SelectedInstance.CanManage, Converter={StaticResource BoolVisibility}}"/>
            </StackPanel></Border>
                <Border Style="{StaticResource Warning}" Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="回收实例" FontWeight="Bold"/><TextBlock Text="{Binding DeleteWarning}" TextWrapping="Wrap" Margin="0,8"/><Button Content="确认回收" Command="{Binding ConfirmDeleteCommand}"/><Button Content="取消" Command="{Binding CancelDeleteCommand}"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
