<UserControl x:Class="McDownload.View.TaskView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:McDownload.ViewModel" xmlns:i18n="clr-namespace:McDownload.i18n">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <Button Content="{i18n:Loc TaskView, Back}" Command="{Binding CloseTasksCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock Text="{i18n:Loc TaskView, Heading}" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding State.QueueSummary}" Foreground="#65758A" Margin="0,0,0,18"/>
        </StackPanel>
        <TextBlock x:Name="TaskError" Grid.Row="1" Text="{Binding State.Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding State.Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Grid Grid.Row="2">
            <TextBlock Text="{i18n:Loc TaskView, NoTasksHint}" TextWrapping="Wrap" Foreground="#65758A" Margin="0,20">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ScrollViewer x:Name="QueueScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TaskQueue" ItemsSource="{Binding State.Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TaskCard">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Margin" Value="0,0,0,12"/>
                                        <Setter Property="Background" Value="#E9EDF2"/><Setter Property="TextElement.Foreground" Value="#83909E"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Running}"><Setter Property="Background" Value="#E9F2FD"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="TextElement.Foreground" Value="#28394C"/></DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Completed}"><Setter Property="Background" Value="White"/><Setter Property="TextElement.Foreground" Value="#28394C"/></DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Failed}"><Setter Property="Background" Value="#FFF0F0"/><Setter Property="TextElement.Foreground" Value="#BC3030"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                            <Button Content="{i18n:Loc TaskView, RemoveFromQueue}" Command="{Binding DataContext.State.RemoveQueuedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsPending, Converter={StaticResource BoolVisibility}}" Style="{StaticResource MutedButton}" Margin="0"/>
                                            <Button Content="{i18n:Loc TaskView, CancelCurrentItem}" Command="{Binding DataContext.State.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Margin="0,5,0,0"/></StackPanel>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"/><TextBlock Text="{i18n:Loc TaskView, OverallProgress}" FontWeight="SemiBold"/></DockPanel>
                                        <ProgressBar x:Name="OverallProgress" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="6" Margin="0,8,0,6" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="{Binding CurrentItem}" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Expander Header="{i18n:Loc TaskView, DetailedProgress}" IsExpanded="{Binding IsExpanded}" Visibility="{Binding HasStarted, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.Style><Style TargetType="Grid"><Setter Property="TextElement.Foreground" Value="#8B96A3"/><Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Completed}"><Setter Property="TextElement.Foreground" Value="#36834A"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Running}"><Setter Property="TextElement.Foreground" Value="{StaticResource Accent}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:QueuedTaskState.Failed}"><Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                            </Style.Triggers></Style></Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <TextBlock Text="{Binding Symbol}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding StatusText}" Margin="12,0,0,0"/>
                                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="4" Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource Accent}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="{i18n:Loc TaskView, RuntimeLogs}" Margin="0,4,0,0"><ListBox ItemsSource="{Binding Logs}" Height="140" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Expander>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
