<UserControl x:Class="McDownload.View.DownloadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McDownload.View" xmlns:i18n="clr-namespace:McDownload.i18n">
    <Grid>
    <ScrollViewer x:Name="DownloadContent" IsEnabled="{Binding IsPageInteractive}" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{i18n:Loc DownloadView, Heading}" Style="{StaticResource Heading}"/>
    <Border BorderBrush="#D9E2ED" BorderThickness="0,0,0,1" Margin="0,0,0,20"><StackPanel Orientation="Horizontal">
        <Button x:Name="MinecraftTab" Content="{i18n:Loc DownloadView, Minecraft}" Style="{StaticResource DownloadTab}" Tag="{Binding IsMinecraftTab}" Command="{Binding SelectMinecraftTabCommand}"/>
        <Button x:Name="ModpackTab" Content="{i18n:Loc DownloadView, ImportModpack}" Style="{StaticResource DownloadTab}" Tag="{Binding IsModpackTab}" Command="{Binding SelectModpackTabCommand}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Visibility="{Binding IsMinecraftTab, Converter={StaticResource BoolVisibility}}"><StackPanel>
        <TextBlock Text="{i18n:Loc DownloadView, InstanceName}" Style="{StaticResource Label}"/><TextBox Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{i18n:Loc DownloadView, MinecraftVersion}" Style="{StaticResource Label}"/>
        <DockPanel><Button x:Name="MinecraftRefreshButton" DockPanel.Dock="Right" Content="{i18n:Loc DownloadView, RefreshVersions}" Command="{Binding RefreshVersionsCommand}" Style="{StaticResource RowButton}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="MinecraftChannelCombo" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedMinecraftChannel}" MinWidth="0"/>
                <ComboBox x:Name="MinecraftVersionCombo" Grid.Column="2" ItemsSource="{Binding MinecraftVersions}" DisplayMemberPath="Id" SelectedItem="{Binding SelectedMinecraftVersion}" MinWidth="0"/>
            </Grid>
        </DockPanel>
        <local:LoaderVersionSelector DataContext="{Binding NewGameLoader}"/>
        <TextBlock Text="{i18n:Loc DownloadView, InstanceIsolationNotice}" Foreground="#65758A" Margin="0,16"/>
        <Button Content="{i18n:Loc DownloadView, DownloadAndInstall}" Command="{Binding InstallGameCommand}" IsEnabled="{Binding NewGameLoader.CanInstall}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <StackPanel Visibility="{Binding IsModpackTab, Converter={StaticResource BoolVisibility}}">
        <StackPanel DataContext="{Binding Modpacks}">
            <Border Background="#EDF7F0" CornerRadius="4" Padding="14" Margin="0,0,0,14" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding Message}" Foreground="#327244" TextWrapping="Wrap"/>
                <Button Content="{i18n:Loc DownloadView, ViewTaskQueue}" Command="{Binding DataContext.OpenTasksCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <Border Background="#FFF0EF" CornerRadius="4" Padding="14" Margin="0,0,0,14" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock x:Name="ModpackError" Text="{Binding Error}" Foreground="#BC3030" TextWrapping="Wrap"/></Border>
            <Border x:Name="ModpackHome" Style="{StaticResource Card}" Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}"><StackPanel>
                <TextBlock Text="{i18n:Loc DownloadView, ImportModpack}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid MinHeight="245" Background="#F9FBFE">
                    <Rectangle x:Name="ModpackDropOutline" Stroke="#B8C9DC" StrokeThickness="2" StrokeDashArray="4,3" RadiusX="5" RadiusY="5" IsHitTestVisible="False"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,28">
                        <Path Data="M 4 25 L 4 34 L 34 34 L 34 25 M 19 25 L 19 2 M 10 11 L 19 2 L 28 11" Stroke="#7A9DBF" StrokeThickness="1.6" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{i18n:Loc DownloadView, DragModpackHint}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{i18n:Loc DownloadView, ModpackFormats}" Foreground="#65758A" Margin="0,10,0,18" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="BrowseModpackButton" Content="{i18n:Loc DownloadView, ChooseFile}" Style="{StaticResource Primary}" Command="{Binding BrowseCommand}" HorizontalAlignment="Center" Margin="0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{i18n:Loc DownloadView, ModpackInstanceNotice}" Foreground="#65758A" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding IsReading, Converter={StaticResource BoolVisibility}}"><StackPanel>
                <TextBlock Text="{i18n:Loc DownloadView, ReadingModpack}" FontSize="16"/><TextBlock Text="{Binding ArchivePath}" Foreground="#65758A" Margin="0,12" TextWrapping="Wrap"/>
                <ProgressBar Height="5" IsIndeterminate="True"/><Button Content="{i18n:Loc DownloadView, CancelReading}" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <StackPanel x:Name="ModpackDetails" Visibility="{Binding HasPack, Converter={StaticResource BoolVisibility}}">
                <DockPanel Margin="0,0,0,12"><Button Content="{i18n:Loc DownloadView, ChooseAgain}" Command="{Binding ResetCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock Text="{i18n:Loc DownloadView, ModpackInformation}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc DownloadView, ModpackFile}" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBlock Text="{Binding ArchivePath}" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <DockPanel><TextBlock Text="{Binding PackFormat}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" Margin="12,0,0,0"/><TextBlock Text="{Binding PackName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
                    <TextBlock Text="{Binding PackVersion}" Foreground="#65758A" Margin="0,6,0,16"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#F7F9FC" Padding="12" CornerRadius="3"><StackPanel><TextBlock Text="{i18n:Loc DownloadView, Minecraft}" Foreground="#65758A"/><TextBlock Text="{Binding MinecraftVersion}" FontWeight="SemiBold" Margin="0,6"/><TextBlock Text="{i18n:Loc DownloadView, SpecifiedByModpack}" Foreground="#65758A" FontSize="11"/></StackPanel></Border>
                        <Border Grid.Column="2" Background="#F7F9FC" Padding="12" CornerRadius="3"><StackPanel><TextBlock Text="{i18n:Loc DownloadView, Loader}" Foreground="#65758A"/><TextBlock Text="{Binding Loader}" FontWeight="SemiBold" Margin="0,6" TextWrapping="Wrap"/><TextBlock Text="{i18n:Loc DownloadView, SpecifiedByModpack}" Foreground="#65758A" FontSize="11"/></StackPanel></Border>
                    </Grid>
                    <TextBlock Text="{Binding FileSummary}" Foreground="#65758A" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource Warning}" Visibility="{Binding IsCurseForge, Converter={StaticResource BoolVisibility}}"><TextBlock x:Name="CurseForgeAccessNotice" Text="{Binding CurseForgeAccessMessage}" TextWrapping="Wrap"/></Border>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc DownloadView, InstanceSettings}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{i18n:Loc DownloadView, InstanceName}" Style="{StaticResource Label}"/><TextBox x:Name="ModpackInstanceName" Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding NameError}" Foreground="#BC3030" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasNameError, Converter={StaticResource BoolVisibility}}"/>
                    <TextBlock Text="{Binding InstancePath}" Foreground="#65758A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{i18n:Loc DownloadView, InstallerJavaOptional}" Style="{StaticResource Label}"/>
                    <DockPanel><Button Content="{i18n:Loc DownloadView, Browse}" DockPanel.Dock="Right" Command="{Binding BrowseJavaCommand}" Style="{StaticResource RowButton}"/><TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
                    <Expander Margin="0,14,0,0"><Expander.Header><TextBlock Text="{Binding OptionalFiles.Count, StringFormat={i18n:Loc DownloadView, OptionalFilesFormat}}"/></Expander.Header><StackPanel>
                        <TextBlock Text="{i18n:Loc DownloadView, NoOptionalFiles}" Foreground="#65758A" Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OptionalFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <ItemsControl ItemsSource="{Binding OptionalFiles}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="0,8" Foreground="#28394C"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Expander>
                </StackPanel></Border>
                <DockPanel Margin="0,4,0,0"><Button x:Name="SubmitModpackButton" Content="{i18n:Loc DownloadView, AddToQueue}" DockPanel.Dock="Right" Style="{StaticResource Primary}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Margin="16,0,0,0"/><TextBlock Text="{i18n:Loc DownloadView, PreserveExistingInstances}" Foreground="#65758A" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    </StackPanel></ScrollViewer>
    <Border x:Name="DownloadOverlay" Background="#D9F3F5F9" Visibility="{Binding IsPageBusy, Converter={StaticResource BoolVisibility}}" Cursor="Wait">
        <Border Background="White" CornerRadius="5" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel><TextBlock Text="{Binding PageBusyMessage}" FontSize="16" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="5" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
