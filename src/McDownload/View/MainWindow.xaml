<Window x:Class="McDownload.View.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McDownload.View" Style="{StaticResource {x:Type Window}}" Title="SolidCraft Installer · SCI" Width="1120" Height="780" MinWidth="820" MinHeight="620">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#EAF0F7" Padding="16,24"><DockPanel LastChildFill="True">
            <Button x:Name="OpenTasksButton" DockPanel.Dock="Bottom" Command="{Binding OpenTasksCommand}" CommandParameter="Tasks" Style="{StaticResource NavigationButton}" Margin="0">
                <StackPanel><TextBlock Text="任务队列"/><TextBlock Text="{Binding State.Status}" FontSize="11" Margin="0,5,0,0" MaxWidth="116" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Button>
            <StackPanel><TextBlock Text="SCI" FontSize="28" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="SolidCraft Installer" Margin="0,4,0,30" FontSize="12"/>
                <Button Content="我的实例" Command="{Binding NavigateCommand}" CommandParameter="Instances" Style="{StaticResource NavigationButton}"/><Button Content="下载游戏" Command="{Binding NavigateCommand}" CommandParameter="Download" Style="{StaticResource NavigationButton}"/><Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavigationButton}"/>
            </StackPanel>
        </DockPanel></Border>
        <Grid Grid.Column="1" Margin="24">
            <local:InstanceListView DataContext="{Binding Instances}"><local:InstanceListView.Style><Style TargetType="local:InstanceListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Instances"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:InstanceListView.Style></local:InstanceListView>
            <local:DownloadView DataContext="{Binding Download}"><local:DownloadView.Style><Style TargetType="local:DownloadView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Download"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:DownloadView.Style></local:DownloadView>
            <local:LoaderManageView DataContext="{Binding Download}"><local:LoaderManageView.Style><Style TargetType="local:LoaderManageView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Loaders"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:LoaderManageView.Style></local:LoaderManageView>
            <local:SettingsView DataContext="{Binding Settings}"><local:SettingsView.Style><Style TargetType="local:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:SettingsView.Style></local:SettingsView>
            <local:TaskView><local:TaskView.Style><Style TargetType="local:TaskView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Tasks"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:TaskView.Style></local:TaskView>
        </Grid>
        <Border x:Name="DeleteOverlay" Grid.ColumnSpan="2" Background="#59000000" Visibility="{Binding Instances.IsDeleteConfirmationVisible, Converter={StaticResource BoolVisibility}}"/>
        <Border x:Name="LogDeleteOverlay" Grid.ColumnSpan="2" Background="#59000000" Visibility="{Binding Settings.IsLogDeleteConfirmationVisible, Converter={StaticResource BoolVisibility}}"/>
    </Grid>
</Window>
