<Window x:Class="McDownload.View.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McDownload.View" Style="{StaticResource {x:Type Window}}" Title="SolidCraft Installer · SCI" Width="1120" Height="780" MinWidth="820" MinHeight="620" AllowDrop="True" PreviewDragOver="WindowDragOver" PreviewDrop="WindowDrop" PreviewDragLeave="WindowDragLeave">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#EAF0F7" Padding="16,24"><DockPanel LastChildFill="True">
            <Button x:Name="OpenTasksButton" DockPanel.Dock="Bottom" Command="{Binding OpenTasksCommand}" CommandParameter="Tasks" Style="{StaticResource NavigationButton}" Margin="0">
                <StackPanel><TextBlock Text="任务队列"/><TextBlock x:Name="TaskAddedNotice" Text="已添加任务" FontWeight="SemiBold" Margin="0,5,0,0" Visibility="{Binding State.HasTaskNotification, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding State.QueueSummary}" FontSize="11" Margin="0,5,0,0" MaxWidth="116" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State.Status}" FontSize="11" Margin="0,5,0,0" MaxWidth="116" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Button>
            <StackPanel><TextBlock Text="SCI" FontSize="28" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="SolidCraft Installer" Margin="0,4,0,30" FontSize="12"/>
                <Button Content="我的实例" Command="{Binding NavigateCommand}" CommandParameter="Instances" Style="{StaticResource NavigationButton}"/><Button Content="下载游戏" Command="{Binding NavigateCommand}" CommandParameter="Download" Style="{StaticResource NavigationButton}"/><Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavigationButton}"/><Button Content="关于" Command="{Binding NavigateCommand}" CommandParameter="About" Style="{StaticResource NavigationButton}"/>
            </StackPanel>
        </DockPanel></Border>
        <Grid Grid.Column="1" Margin="24">
            <local:AboutView><local:AboutView.Style><Style TargetType="local:AboutView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="About"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:AboutView.Style></local:AboutView>
            <local:LicensesView DataContext="{Binding Licenses}"><local:LicensesView.Style><Style TargetType="local:LicensesView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Licenses"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:LicensesView.Style></local:LicensesView>
            <local:ProjectLicenseView DataContext="{Binding Licenses}"><local:ProjectLicenseView.Style><Style TargetType="local:ProjectLicenseView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="ProjectLicense"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:ProjectLicenseView.Style></local:ProjectLicenseView>
            <local:InstanceListView DataContext="{Binding Instances}"><local:InstanceListView.Style><Style TargetType="local:InstanceListView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Instances"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:InstanceListView.Style></local:InstanceListView>
            <local:DownloadView DataContext="{Binding Download}"><local:DownloadView.Style><Style TargetType="local:DownloadView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Download"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:DownloadView.Style></local:DownloadView>
            <local:LoaderManageView DataContext="{Binding Download}"><local:LoaderManageView.Style><Style TargetType="local:LoaderManageView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Loaders"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:LoaderManageView.Style></local:LoaderManageView>
            <local:SettingsView DataContext="{Binding Settings}"><local:SettingsView.Style><Style TargetType="local:SettingsView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:SettingsView.Style></local:SettingsView>
            <local:TaskView><local:TaskView.Style><Style TargetType="local:TaskView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Tasks"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:TaskView.Style></local:TaskView>
            <local:ModpackResumeView DataContext="{Binding ModpackResume}"><local:ModpackResumeView.Style><Style TargetType="local:ModpackResumeView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="ModpackResume"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:ModpackResumeView.Style></local:ModpackResumeView>
        </Grid>
        <Border x:Name="DeleteOverlay" Grid.ColumnSpan="2" Background="#59000000" Visibility="{Binding Instances.IsDeleteConfirmationVisible, Converter={StaticResource BoolVisibility}}"/>
        <Border x:Name="LogDeleteOverlay" Grid.ColumnSpan="2" Background="#59000000" Visibility="{Binding Settings.IsLogDeleteConfirmationVisible, Converter={StaticResource BoolVisibility}}"/>
        <Border Grid.ColumnSpan="2" Background="#59000000" Visibility="{Binding Settings.IsExternalLinkConfirmationVisible, Converter={StaticResource BoolVisibility}}"/>
        <Grid x:Name="ModpackDragOverlay" Grid.ColumnSpan="2" Background="#EAF3F8FE" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle Margin="20" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="5,4" RadiusX="5" RadiusY="5"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="松开以导入整合包" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Modrinth .mrpack / CurseForge .zip" Foreground="#65758A" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel>
        </Grid>
    </Grid>
</Window>
