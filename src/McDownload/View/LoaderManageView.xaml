<UserControl x:Class="McDownload.View.LoaderManageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McDownload.View">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="加载器管理" Style="{StaticResource Heading}"/>
        <StackPanel Style="{StaticResource IdlePanel}"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TargetInstance.Editable.DisplayName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TargetInstance.MinecraftVersionId, StringFormat=Minecraft {0}}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="×" AutomationProperties.Name="删除当前加载器" Command="{Binding RequestRemoveCommand}"/><TextBlock Text="{Binding CurrentLoader}" VerticalAlignment="Center"/></DockPanel><Button Content="下载 / 校验原版游戏" Command="{Binding ResumeGameCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Warning}"><TextBlock Text="不会删除 mods 文件夹中的模组，但旧模组可能不兼容新加载器。" TextWrapping="Wrap"/></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="安装或更换加载器" FontSize="17" FontWeight="SemiBold"/>
                <local:LoaderVersionSelector DataContext="{Binding InstanceLoader}"/>
                <Button Content="安装 / 更换" Command="{Binding InstallLoaderCommand}" IsEnabled="{Binding InstanceLoader.CanInstall}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Warning}" Visibility="{Binding IsLoaderConfirmationVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding ConfirmationText}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="不会删除 mods 文件夹中的模组，但旧模组可能不兼容新加载器。" TextWrapping="Wrap" Margin="0,8"/><WrapPanel><Button Content="确认" Command="{Binding ConfirmLoaderCommand}"/><Button Content="取消" Command="{Binding CancelConfirmationCommand}"/></WrapPanel></StackPanel></Border>
        </StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding State.Status}"/><ProgressBar Margin="0,10" Height="6" Value="{Binding State.Progress}" Maximum="100" IsIndeterminate="{Binding State.IsIndeterminate}"/><Button Content="取消任务" Command="{Binding State.CancelCommand}" IsEnabled="{Binding State.IsBusy}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding State.Logs}" Height="120" FontFamily="Consolas" BorderThickness="0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
