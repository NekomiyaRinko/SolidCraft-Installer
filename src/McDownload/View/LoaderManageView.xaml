<UserControl x:Class="McDownload.View.LoaderManageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McDownload.View" xmlns:i18n="clr-namespace:McDownload.i18n">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{i18n:Loc LoaderManageView, Heading}" Style="{StaticResource Heading}"/>
        <StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding TargetInstance.Editable.DisplayName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding TargetInstance.MinecraftVersionId, StringFormat={i18n:Loc LoaderManageView, MinecraftVersionFormat}}" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="{i18n:Loc LoaderManageView, RemoveSymbol}" AutomationProperties.Name="{i18n:Loc LoaderManageView, RemoveCurrentLoader}" Command="{Binding RequestRemoveCommand}"/><TextBlock Text="{Binding CurrentLoader}" VerticalAlignment="Center"/></DockPanel><Button Content="{i18n:Loc LoaderManageView, ResumeGame}" Command="{Binding ResumeGameCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Warning}"><TextBlock Text="{i18n:Loc LoaderManageView, ModCompatibilityNotice}" TextWrapping="Wrap"/></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{i18n:Loc LoaderManageView, InstallHeading}" FontSize="17" FontWeight="SemiBold"/>
                <local:LoaderVersionSelector DataContext="{Binding InstanceLoader}"/>
                <Button Content="{i18n:Loc LoaderManageView, InstallOrReplace}" Command="{Binding InstallLoaderCommand}" IsEnabled="{Binding InstanceLoader.CanInstall}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Warning}" Visibility="{Binding IsLoaderConfirmationVisible, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding ConfirmationText}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{i18n:Loc LoaderManageView, ModCompatibilityNotice}" TextWrapping="Wrap" Margin="0,8"/><WrapPanel><Button Content="{i18n:Loc LoaderManageView, Confirm}" Command="{Binding ConfirmLoaderCommand}"/><Button Content="{i18n:Loc LoaderManageView, Cancel}" Command="{Binding CancelConfirmationCommand}"/></WrapPanel></StackPanel></Border>
        </StackPanel>
    </StackPanel></ScrollViewer>
</UserControl>
